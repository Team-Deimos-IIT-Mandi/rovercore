<?xml version="1.0" encoding="utf-8"?>
<!--
  Assem10_real.urdf.xacro
  Real-hardware variant of the rover URDF.
  Replaces IgnitionSystem with RoverSerialInterface for ros2_control.
  All geometry, joints, and sensors are inherited from Assem10.urdf via xacro:include.
-->
<robot name="Assem10" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Pull in the base URDF (geometry, sensors, TF tree) -->
  <xacro:include filename="$(find rover_description)/urdf/Assem10.urdf"/>

  <!-- Override the ros2_control hardware plugin: replace IgnitionSystem with real UART interface -->
  <!-- NOTE: This replaces the <ros2_control> block defined in Assem10.urdf at load time.
       ros2_control_node will use the *last* matching block it finds in the merged model. -->
  <ros2_control name="RoverRealSystem" type="system">
    <hardware>
      <plugin name="gazebo_ros_gps" filename="libgazebo_ros_gps_sensor.so">
  <ros>
    <namespace>/rover</namespace>
    <remapping>~/out:=gps/fix</remapping>
  </ros>
</plugin>
      <plugin>rover_hardware/RoverSerialInterface</plugin>
      <param name="serial_port">/dev/ttyTHS0</param>
    </hardware>
    <joint name="LF_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LB_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RF_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RB_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
