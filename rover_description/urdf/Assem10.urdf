        <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>100</far></clip>
      </camera>
    </sensor>
    
    <light type="spot" name="front_headlight">
      <pose>0 0.05 0 0 0 1.5708</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.1</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <direction>1 0 0</direction>
      <spot>
        <inner_angle>0.5</inner_angle>
        <outer_angle>1.0</outer_angle>
        <falloff>1.0</falloff>
      </spot>
    </light>
  </gazebo>

