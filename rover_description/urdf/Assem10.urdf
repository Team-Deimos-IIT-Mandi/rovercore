      <geometry>
        <mesh
          filename="package://rover_description/meshes/RB.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rover_description/meshes/RB.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="RB_joint"
    type="continuous">
    <origin
      xyz="-0.29083 -0.30414 0.34891"
      rpy="-1.5708 0 -1.5708" />
    <parent
      link="base_link" />
    <child
      link="RB" />
    <axis
      xyz="-1 0 0" />
    <limit
      effort="100"
      velocity="10" />
  </joint>
  <link
    name="IMU">
    <inertial>
      <origin
        xyz="0.00134193003921145 0.00154722539149073 -0.00169171674705683"
        rpy="0 0 0" />
      <mass
        value="0.01" />
      <inertia
        ixx="1e-05"
        ixy="0"
        ixz="0"
        iyy="1e-05"
        iyz="0"
        izz="1e-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rover_description/meshes/IMU.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rover_description/meshes/IMU.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="IMU_joint"
    type="fixed">
    <origin
      xyz="0.023111 0.0074304 0.026248"
      rpy="-1.5708 0.019058 -1.5708" />
    <parent
      link="base_link" />
    <child
      link="IMU" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
    name="OPTICAL">
    <inertial>
      <origin
        xyz="-1.73472347597681E-18 1.38777878078145E-17 -0.00318525013167438"
        rpy="0 0 0" />
      <mass
        value="0.01" />
      <inertia
        ixx="1e-05"
        ixy="0"
        ixz="0"
        iyy="1e-05"
        iyz="0"
        izz="1e-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rover_description/meshes/OPTICAL.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rover_description/meshes/OPTICAL.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="OPTICAL_joint"
    type="fixed">
    <origin
      xyz="-0.091551 0.0046556 0.087323"
      rpy="-1.5708 0 -1.5708" />
    <parent
      link="base_link" />
    <child
      link="OPTICAL" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
    name="GPS">
    <inertial>
      <origin
        xyz="0 1.38777878078145E-17 -0.0295024951902178"
        rpy="0 0 0" />
      <mass
        value="0.0146410874338426" />
      <inertia
        ixx="3.17358826692755E-05"
        ixy="-1.16645391067021E-21"
        ixz="3.22446708881848E-20"
        iyy="3.17358826692755E-05"
        iyz="1.78096689542018E-20"
        izz="1.93641269939486E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rover_description/meshes/GPS.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rover_description/meshes/GPS.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="GPS_joint"
    type="fixed">
    <origin
      xyz="0.19045 0.20596 0.09541"
      rpy="-1.5708 0 -1.5708" />
    <parent
      link="base_link" />
    <child
      link="GPS" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link name="FLOW_CAM">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
  </link>
  <joint name="FLOW_CAM_joint" type="fixed">
    <origin xyz="-0.16 0.0 -0.22" rpy="-1.5708 0 -1.5708"/>
    <parent link="base_link"/>
    <child link="FLOW_CAM"/>
    <axis xyz="0 0 0"/>
  </joint>
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="LF_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RF_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LB_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RB_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo reference="base_link">
    <material>Gazebo/Pink</material>
  </gazebo>
  
  <gazebo reference="LF">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Red</material>
  </gazebo>
  
  <gazebo reference="RF">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Red</material>
  </gazebo>
  
  <gazebo reference="LB">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Red</material>
  </gazebo>
  
  <gazebo reference="RB">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Diff drive via Ignition's built-in plugin (no gz_ros2_control needed) -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>LF_joint</left_joint>
      <left_joint>LB_joint</left_joint>
      <right_joint>RF_joint</right_joint>
      <right_joint>RB_joint</right_joint>
      <wheel_separation>0.62</wheel_separation>
      <wheel_radius>0.14</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!-- <tf_topic>tf</tf_topic> -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint state publisher for wheel positions -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>LF_joint</joint_name>
      <joint_name>LB_joint</joint_name>
      <joint_name>RF_joint</joint_name>
      <joint_name>RB_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- IMU sensor on the IMU link -->
  <gazebo reference="IMU">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- GPS (NavSat) sensor on the GPS link -->
  <gazebo reference="GPS">
    <sensor name="navsat_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>gps/fix</topic>
    </sensor>
  </gazebo>

  <!-- RGBD Camera on the OPTICAL link -->
  <gazebo reference="OPTICAL">
    <sensor name="rgbd_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>rgbd_camera/image</topic>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Downward optical flow camera on FLOW_CAM link (simulates PMW3901) -->
  <gazebo reference="FLOW_CAM">
    <sensor name="flow_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>flow_cam/image</topic>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>120</width>
          <height>120</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>10</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Downward rangefinder on FLOW_CAM link (simulates MTF-01 ToF) -->
  <gazebo reference="FLOW_CAM">
    <sensor name="range_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>range/height</topic>
      <pose>0 0 0 0 0 0</pose>
      <lidar>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.01</min>
          <max>8.0</max>
          <resolution>0.001</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- 2D Lidar on base_link -->
  <gazebo reference="base_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <pose>0.1 0 0.15 0 0 0</pose>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>