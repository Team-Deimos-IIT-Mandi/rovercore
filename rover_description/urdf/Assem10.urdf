    <inertial>
      <origin
        xyz="-0.0702271724870632 1.23412855801974E-05 -5.41779169571655E-06"
        rpy="0 0 0" />
      <mass
        value="3.57448131006854" />
      <inertia
        ixx="0.0295859622143954"
        ixy="-5.64502264178318E-10"
        ixz="1.31208309299921E-10"
        iyy="0.0205546643219842"
        iyz="2.16675039901438E-06"
        izz="0.0205585841429814" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
