import cv2
import numpy as np
from ultralytics import YOLO

# ─── Configuration ────────────────────────────────────────────
MODE = "image"                 # "live" or "image"
CAMERA_SOURCE = "system"       # "system" or "ip"
DETECTION_MODEL = "masking"    # "masking" or "yolo"
SYSTEM_CAM_INDEX = 0           # /dev/video0
IP_CAMERA_URL = "http://10.212.162.142:8000/video"  # IP Webcam MJPEG stream
IP_CAMERA_FPS = 30                # target fps for IP camera (appended as ?fps=)
IMAGE_PATH = "img6.jpeg"       # static image for image mode
OUTPUT = "output6.jpg"

# YOLO options (used when DETECTION_MODEL == "yolo")
YOLO_MODEL_PATH = "yolo11s.pt"  # auto-downloaded on first use
YOLO_CONFIDENCE = 0.25
YOLO_IOU = 0.45
YOLO_CLASSES = []               # filter by COCO class IDs (empty = all)

# Color masking options (used when DETECTION_MODEL == "masking")
V_THRESHOLD = 45              # mean V below this = ilmenite, above = normal
MIN_AREA = 500                # minimum rock contour area (pixels)
MAX_AREA = 100000
BLOCK_SIZE = 51               # adaptive threshold block size (odd)
C_VALUE = 10                  # adaptive threshold C
BLUR = 5                      # gaussian blur kernel size (odd)
# HSV range masking
HUE_MIN = 0                   # HSV lower bound (hue)
HUE_MAX = 180                 # HSV upper bound (hue)
SAT_MIN = 0                   # HSV lower bound (saturation)
SAT_MAX = 255                 # HSV upper bound (saturation)
VAL_MIN = 0                   # HSV lower bound (value)
VAL_MAX = 255                 # HSV upper bound (value)
# ──────────────────────────────────────────────────────────────


COLORS = {
    "illemenite": (0, 0, 255),
    "normal":     (0, 255, 255),
}

CTRL_WIN = "Controls"


def classify_masking(image):
    if image is None or image.size == 0:
        return [], None

    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    _, s, v = cv2.split(hsv)

    blur = cv2.GaussianBlur(v, (BLUR | 1,) * 2, 0)
    binary = cv2.adaptiveThreshold(
        blur, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY_INV, BLOCK_SIZE | 1, C_VALUE,
    )
    binary = cv2.morphologyEx(binary, cv2.MORPH_CLOSE,
                              cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7)))

    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    rocks = []
    for cnt in contours:
        area = cv2.contourArea(cnt)
        if area < MIN_AREA or area > MAX_AREA:
            continue

        mask = np.zeros(image.shape[:2], dtype=np.uint8)
        cv2.drawContours(mask, [cnt], -1, 255, -1)
        mean_v = cv2.mean(v, mask=mask)[0]

        x, y, w, h = cv2.boundingRect(cnt)
        M = cv2.moments(cnt)
        cx = int(M["m10"] / M["m00"]) if M["m00"] else x + w // 2
        cy = int(M["m01"] / M["m00"]) if M["m00"] else y + h // 2

        is_ill = mean_v < V_THRESHOLD
        rocks.append({
            "class": "illemenite" if is_ill else "normal",
            "bbox": (x, y, w, h),
            "centroid": (cx, cy),
            "area": int(area),
            "mean_v": round(mean_v, 1),
        })

    rocks.sort(key=lambda r: r["area"], reverse=True)
    return rocks, binary


yolo_model = None

def classify_yolo(image):
    global yolo_model
    if yolo_model is None:
        yolo_model = YOLO(YOLO_MODEL_PATH)
    results = yolo_model(image, conf=YOLO_CONFIDENCE, iou=YOLO_IOU,
                          classes=YOLO_CLASSES or None, verbose=False)

    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    _, _, v = cv2.split(hsv)
    rocks = []
    binary = np.zeros(image.shape[:2], dtype=np.uint8)

    for det in results[0].boxes.data:
        x1, y1, x2, y2, conf, cls_id = det.tolist()
        x, y, w, h = int(x1), int(y1), int(x2 - x1), int(y2 - y1)
        cx, cy = x + w // 2, y + h // 2
        area = w * h

        mask = np.zeros(image.shape[:2], dtype=np.uint8)
        cv2.rectangle(mask, (x, y), (x + w, y + h), 255, -1)
        mean_v = cv2.mean(v, mask=mask)[0]
        is_ill = mean_v < V_THRESHOLD

        rocks.append({
            "class": "illemenite" if is_ill else "normal",
            "bbox": (x, y, w, h),
            "centroid": (cx, cy),
            "area": area,
            "mean_v": round(mean_v, 1),
        })
        cv2.rectangle(binary, (x, y), (x + w, y + h), 255, -1)

    rocks.sort(key=lambda r: r["area"], reverse=True)
    return rocks, binary


def classify(image):
    return classify_yolo(image) if DETECTION_MODEL == "yolo" else classify_masking(image)


def annotate(image, rocks):
    out = image.copy()
    for r in rocks:
        x, y, w, h = r["bbox"]
        color = COLORS[r["class"]]
        cv2.rectangle(out, (x, y), (x + w, y + h), color, 2)
        cv2.circle(out, r["centroid"], 4, color, -1)
    ill = sum(1 for r in rocks if r["class"] == "illemenite")
    cv2.putText(out, f"Ilmenite: {ill}  Normal: {len(rocks)-ill}  Total: {len(rocks)}",
                (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    return out


def get_hsv_range_mask(image):
    """Get HSV range mask from image using current HUE/SAT/VAL settings"""
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    lower = np.array([HUE_MIN, SAT_MIN, VAL_MIN])
    upper = np.array([HUE_MAX, SAT_MAX, VAL_MAX])
    return cv2.inRange(hsv, lower, upper), hsv


def visualize_hsv_mask(image, mask):
    """Convert mask to BGR for display"""
    mask_bgr = cv2.cvtColor(mask, cv2.COLOR_GRAY2BGR)
    return mask_bgr


def setup_controls():
    cv2.namedWindow(CTRL_WIN)
    cv2.createTrackbar("V threshold", CTRL_WIN, V_THRESHOLD, 255, lambda _: None)
    cv2.createTrackbar("Block size", CTRL_WIN, BLOCK_SIZE, 199, lambda _: None)
    cv2.createTrackbar("C value (+50)", CTRL_WIN, C_VALUE + 50, 100, lambda _: None)
    cv2.createTrackbar("Blur", CTRL_WIN, BLUR, 31, lambda _: None)
    cv2.createTrackbar("Min area", CTRL_WIN, MIN_AREA, 10000, lambda _: None)
    cv2.createTrackbar("Max area (x100)", CTRL_WIN, MAX_AREA // 100, 5000, lambda _: None)
    cv2.createTrackbar("H min", CTRL_WIN, HUE_MIN, 179, lambda _: None)
    cv2.createTrackbar("H max", CTRL_WIN, HUE_MAX, 179, lambda _: None)
    cv2.createTrackbar("S min", CTRL_WIN, SAT_MIN, 255, lambda _: None)
    cv2.createTrackbar("S max", CTRL_WIN, SAT_MAX, 255, lambda _: None)
    cv2.createTrackbar("V min", CTRL_WIN, VAL_MIN, 255, lambda _: None)
    cv2.createTrackbar("V max", CTRL_WIN, VAL_MAX, 255, lambda _: None)


def sync_controls():
    global V_THRESHOLD, BLOCK_SIZE, C_VALUE, BLUR, MIN_AREA, MAX_AREA, HUE_MIN, HUE_MAX, SAT_MIN, SAT_MAX, VAL_MIN, VAL_MAX
    V_THRESHOLD = max(1, cv2.getTrackbarPos("V threshold", CTRL_WIN))
    BLOCK_SIZE = max(3, cv2.getTrackbarPos("Block size", CTRL_WIN) | 1)
    C_VALUE = cv2.getTrackbarPos("C value (+50)", CTRL_WIN) - 50
    BLUR = max(1, cv2.getTrackbarPos("Blur", CTRL_WIN) | 1)
    MIN_AREA = max(0, cv2.getTrackbarPos("Min area", CTRL_WIN))
    MAX_AREA = max(100, cv2.getTrackbarPos("Max area (x100)", CTRL_WIN) * 100)
    HUE_MIN = max(0, cv2.getTrackbarPos("H min", CTRL_WIN))
    HUE_MAX = max(HUE_MIN + 1, cv2.getTrackbarPos("H max", CTRL_WIN))
    SAT_MIN = max(0, cv2.getTrackbarPos("S min", CTRL_WIN))
    SAT_MAX = max(SAT_MIN + 1, cv2.getTrackbarPos("S max", CTRL_WIN))
    VAL_MIN = max(0, cv2.getTrackbarPos("V min", CTRL_WIN))
    VAL_MAX = max(VAL_MIN + 1, cv2.getTrackbarPos("V max", CTRL_WIN))


def live():
    src = SYSTEM_CAM_INDEX if CAMERA_SOURCE == "system" else f"{IP_CAMERA_URL}?fps={IP_CAMERA_FPS}"
    cap = cv2.VideoCapture(src)
    if not cap.isOpened():
        print(f"Could not open camera source: {src}")
        return

    if DETECTION_MODEL == "masking":
        setup_controls()
        print("Live — q: quit, s: save | Tune in 'Controls' window")
    else:
        print(f"Live (YOLO) — q: quit, s: save | Model: {YOLO_MODEL_PATH}")

    try:
        while True:
            ret, frame = cap.read()
            if not ret:
                continue

            if DETECTION_MODEL == "masking":
                sync_controls()
            rocks, binary = classify(frame)
            annotated = annotate(frame, rocks)

            # Get HSV range mask and visualize it
            hsv_mask, _ = get_hsv_range_mask(frame)
            hsv_mask_bgr = visualize_hsv_mask(frame, hsv_mask)

            # Show three panels: Original | Mask | Annotated Results
            panels = [annotated, cv2.cvtColor(binary, cv2.COLOR_GRAY2BGR), hsv_mask_bgr]
            # If we're in YOLO mode, we only have 2 panels to show (annotated and mask)
            if DETECTION_MODEL == "yolo":
                panels = [annotated, cv2.cvtColor(binary, cv2.COLOR_GRAY2BGR)]

            cv2.imshow("Rocks", np.vstack(panels))

            key = cv2.waitKey(1) & 0xFF
            if key == ord("q"):
                break
            elif key == ord("s"):
                cv2.imwrite("capture.jpg", annotated)
                print("Saved capture.jpg")
    finally:
        cap.release()
        cv2.destroyAllWindows()


def image_mode():
    if CAMERA_SOURCE == "ip":
        print("IP camera requires MODE='live'. Set MODE='live' to use the IP camera.")
        return

    img = cv2.imread(IMAGE_PATH)
    if img is None:
        print(f"Could not load '{IMAGE_PATH}'")
        return

    # Setup controls window for image mode
    setup_controls()
    print("Image mode - 'q': quit | Adjust HSV controls in 'Controls' window")

    rocks, _ = classify(img)
    ill = [r for r in rocks if r["class"] == "illemenite"]
    print(f"Ilmenite: {len(ill)}  Normal: {len(rocks)-len(ill)}  Total: {len(rocks)}")
    for r in rocks:
        x, y, w, h = r["bbox"]
        print(f"  {r['class']:>10s}  V={r['mean_v']:.0f}  area={r['area']}px  "
              f"bbox=({x},{y},{w},{h})")

    # Get HSV range mask for visualization
    hsv_mask, _ = get_hsv_range_mask(img)
    hsv_mask_bgr = visualize_hsv_mask(img, hsv_mask)

    out = annotate(img, rocks)
    cv2.imwrite(OUTPUT, out)
    print(f"Saved '{OUTPUT}'")
    cv2.namedWindow("Rocks", cv2.WINDOW_NORMAL)
    cv2.resizeWindow("Rocks", 1600, 1600)
    
    # Show image with annotations, binary mask, and HSV mask
    panels = [out, cv2.cvtColor(np.zeros_like(img), cv2.COLOR_BGR2GRAY), hsv_mask_bgr]
    cv2.imshow("Rocks", np.vstack(panels))
    
    while True:
        key = cv2.waitKey(0) & 0xFF
        if key == ord("q"):
            break
    cv2.destroyAllWindows()


# ─── Entry ────────────────────────────────────────────────────

if __name__ == "__main__":
    if MODE == "live":
        live()
    else:
        image_mode()
