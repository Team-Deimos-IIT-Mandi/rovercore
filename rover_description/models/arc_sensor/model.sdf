<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="arc_sensor">
    <!--
      Anatolian Rover Challenge (ARC'26) - Collaboration Mission ground sensor.
      Reconstructed from the dimensioned technical drawing in Section 8.7
      "Sensors - Collaboration Mission" (ARC'26 Manual v.3, page 48).

      Reference dimensions taken from the drawing (mm -> m):
        - Total height (incl. dome, excl. whip antenna) ........ 190 mm -> 0.190 m
        - Height from top of shoulder collar to base ............ 148 mm -> 0.148 m
        - Antenna stub diameter ................................. 20 mm  -> 0.020 m
        - Base (buried) cylinder diameter ....................... 84 mm  -> 0.084 m (r = 0.042 m)

      Coordinate convention: model origin (0,0,0) is at the centre of the
      flat bottom face of the buried base cylinder, +Z is up, matching how
      the part would be planted into the regolith with its base downward.

      The part is static (it sits in/on the ground until a rover
      disconnects and collects it per Manual section 7.1.4.1, step 3,
      "Collect Sensors").
    -->

    <static>true</static>

    <link name="sensor_link">

      <inertial>
        <mass>0.35</mass>
        <pose>0 0 0.075 0 0 0</pose>
        <inertia>
          <ixx>0.0012</ixx>
          <iyy>0.0012</iyy>
          <izz>0.0004</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- ============================================================ -->
      <!-- VISUAL: high-fidelity revolved bellows body (dome + neck +    -->
      <!-- conical shoulder + ribbed housing + cylindrical base), built  -->
      <!-- from the dimensioned profile traced off the drawing.          -->
      <!-- ============================================================ -->
      <visual name="visual_body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/sensor_body.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- Flexible whip antenna above the dome, drawn as a zig-zag
           (spring/whip) symbol. Modeled as a thin cylinder for
           collision/visual simplicity. -->
      <visual name="visual_whip_antenna">
        <pose>0 0 0.220 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0015</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- Two vertical slot cutouts on the cylindrical base, visible in
           the front (side) view near the bottom of the unit. Modeled as
           thin recessed boxes for visual reference (non-subtractive). -->
      <visual name="visual_slot_left">
        <pose>-0.018 0.0415 0.018 0 0 0</pose>
        <geometry>
          <box>
            <size>0.006 0.002 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>

      <visual name="visual_slot_right">
        <pose>0.018 0.0415 0.018 0 0 0</pose>
        <geometry>
          <box>
            <size>0.006 0.002 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>

      <!-- ============================================================ -->
      <!-- COLLISION: simplified compound primitives approximating the   -->
      <!-- visual envelope (cylindrical base + tapered bellows body as a -->
      <!-- conical frustum + dome cap + thin antenna stalk), for         -->
      <!-- efficient physics-engine collision checking.                  -->
      <!-- ============================================================ -->

      <!-- Base cylinder (the part planted/buried in the ground): Ø84mm -->
      <collision name="collision_base">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Ribbed bellows housing, approximated as a tapered cylinder
           (cone frustum) from the base up to the shoulder collar -->
      <collision name="collision_bellows">
        <pose>0 0 0.074 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.039</radius>
            <length>0.088</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Conical shoulder collar -->
      <collision name="collision_shoulder">
        <pose>0 0 0.133 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Neck + antenna stalk, Ø20mm -->
      <collision name="collision_stalk">
        <pose>0 0 0.168 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.010</radius>
            <length>0.040</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Dome cap -->
      <collision name="collision_dome">
        <pose>0 0 0.185 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.0075</radius>
          </sphere>
        </geometry>
      </collision>

      <!-- Whip antenna -->
      <collision name="collision_whip">
        <pose>0 0 0.220 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0015</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>
