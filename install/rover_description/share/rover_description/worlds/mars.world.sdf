<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.9">
  <world name="mars_world">
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation> 
      <latitude_deg>39.8942</latitude_deg>  
      <longitude_deg>32.7845</longitude_deg> 
      <elevation>900.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.01 0.01 0.01 1</ambient>
      <background>0.0 0.0 0.0 1</background>
      <shadows>true</shadows>
      <origin_visual>false</origin_visual>
      <grid>false</grid>
    </scene>

    <include>
      <name>ground</name>
      <uri>model://gale_crater_patch2</uri>
    </include>

    <gui>
      <camera name="user_camera">
        <projection_type>orthographic</projection_type>
        <pose>1.5 -1.25 0 0 1.578 0</pose>
      </camera>
    </gui>

    <model name="night_mission_rocket">
      <static>true</static>
      <pose>16.0 8.0 3.36 1.570796 0 -0.5</pose>
      <link name="base_link">
        
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>../models/gale_crater_patch2/meshes/rocket.obj</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name="collision">
          <geometry>
            <mesh>
               <uri>../models/gale_crater_patch2/meshes/rocket.obj</uri>
            </mesh>
          </geometry>
        </collision>
        
      </link>
    </model>

    <model name="astronaut">
      <static>true</static>

      <!-- x y z roll pitch yaw -->
      <pose>16 -14 0.17 1.5708 0 0.2</pose>

      <link name="link">

        <visual name="visual">
          <geometry>
            <mesh>
              <scale>0.4 0.4 0.4</scale>
              <uri>../models/gale_crater_patch2/meshes/Astronaut.obj</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name="collision">
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>../models/gale_crater_patch2/meshes/Astronaut.obj</uri>
            </mesh>
          </geometry>
        </collision>

      </link>
    </model>

    <model name="mars_base_dome">
      <static>true</static>

      <pose>-5 3.5 -0.25 1.570795 0 -1.570795</pose>

      <link name="dome_link">

        <visual name="dome_visual">
          <geometry>
            <mesh>
              <uri>../models/gale_crater_patch2/meshes/dome.obj</uri>

              <!-- rover can fit -->
              <scale>0.82 0.82 0.82</scale>

            </mesh>
          </geometry>
        </visual>

        <collision name="dome_collision">
          <geometry>
            <box>
              <size>3.0 3.0 2.0</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>

    <model name="arc_toolbox">
      <static>true</static>

      <pose>16 -12 0.345 1.570795 -0.02 0</pose>

      <link name="toolbox_link">

        <visual name="toolbox_visual">
          <geometry>
            <mesh>
              <uri>../models/gale_crater_patch2/meshes/Toolbox.obj</uri>
              <scale>1.1 1.1 1.1</scale>
            </mesh>
          </geometry>

          <material>
            <ambient>0.55 0.57 0.62 1</ambient>
            <diffuse>0.55 0.57 0.62 1</diffuse>
          </material>
        </visual>

        <collision name="toolbox_collision">
          <geometry>
            <box>
              <size>0.38 0.20 0.25</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>
    
    <model name="arc_repair_tool_flat">

      <static>false</static>

      <pose>16 -12 0.361 1.570795 0 0</pose>

      <link name="repair_tool_link">

        <inertial>

          <mass>2</mass>

          <inertia>

            <ixx>0.05</ixx>
            <iyy>0.05</iyy>
            <izz>0.05</izz>

            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>

          </inertia>

        </inertial>

        <pose>0 0 0 0 0 0</pose>

        <visual name="repair_tool_visual">

          <geometry>

            <mesh>

              <uri>../models/gale_crater_patch2/meshes/repair_tool.obj</uri>

              <scale>1 1 1</scale>

            </mesh>

          </geometry>

        </visual>

        <collision name="repair_tool_collision">

          <geometry>

            <box>

              <size>0.2 0.2 0.03</size>

            </box>

          </geometry>

        </collision>

      </link>

    </model>

    <model name="Arc_emergency_kit">
      <static>true</static>

      <pose>-5 -3 0.13 1.5708 0 -1.570795</pose>

      <link name="kit_link">

        <visual name="kit_visual">
          <geometry>
            <mesh>
              <uri>../models/gale_crater_patch2/meshes/Emergency_kit.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>

        <collision name="kit_collision">
          <geometry>
            <box>
              <size>0.33 0.10 0.24</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>
    
    
    <model name="arc_oxygen_tank_night_mission">
      <static>true</static>
      <pose>25.8 -6 0.7 0 0 -1.1</pose> <link name="support_base">
        <pose>0 0 0.09 0 0 0</pose>

        <visual name="visual_base">
          <geometry>
            <box>
              <size>0.55 0.22 0.18</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.50 0.50 0.50 1</diffuse>
            <specular>0.20 0.20 0.20 1</specular>
          </material>
        </visual>

        <collision name="collision_base">
          <geometry>
            <box>
              <size>0.55 0.22 0.18</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="tank_body">
        <pose>0 0 0.30 0 1.5708 0</pose>

        <visual name="visual_tank">
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.52</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.25 0.05 1</ambient>
            <diffuse>0.08 0.35 0.08 1</diffuse>
            <specular>0.05 0.10 0.05 1</specular>
            <emissive>0.01 0.06 0.01 1</emissive>
          </material>
        </visual>

        <collision name="collision_tank">
          <geometry>
            <box>
              <size>0.52 0.24 0.24</size>
            </box>
          </geometry>
        </collision>
      </link>

      <joint name="joint_base_to_tank" type="fixed">
        <parent>support_base</parent>
        <child>tank_body</child>
      </joint>

      <link name="tank_endcap">
        <pose>-0.285 0 0.30 0 0 0</pose>

        <visual name="visual_endcap">
          <geometry>
            <sphere>
              <radius>0.12</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.05 0.22 0.05 1</ambient>
            <diffuse>0.07 0.30 0.07 1</diffuse>
            <emissive>0.01 0.05 0.01 1</emissive>
          </material>
        </visual>

        <collision name="collision_endcap">
          <geometry>
            <sphere>
              <radius>0.12</radius>
            </sphere>
          </geometry>
        </collision>
      </link>

      <joint name="joint_base_to_endcap" type="fixed">
        <parent>support_base</parent>
        <child>tank_endcap</child>
      </joint>

      <link name="valve_body">
        <pose>0.285 0 0.30 0 0 0</pose>

        <visual name="visual_valve_body">
          <geometry>
            <box>
              <size>0.05 0.07 0.07</size>
            </box>
          </geometry>
          <material>
            <ambient>0.60 0.60 0.65 1</ambient>
            <diffuse>0.70 0.70 0.75 1</diffuse>
            <specular>0.80 0.80 0.85 1</specular>
          </material>
        </visual>

        <collision name="collision_valve_body">
          <geometry>
            <box>
              <size>0.05 0.07 0.07</size>
            </box>
          </geometry>
        </collision>
      </link>

      <joint name="joint_tank_to_valve" type="fixed">
        <parent>tank_body</parent>
        <child>valve_body</child>
      </joint>

      <link name="valve_handle">
        <pose>0.285 0 0.347 0 0 0</pose>

        <visual name="visual_valve_handle">
          <geometry>
            <box>
              <size>0.06 0.015 0.024</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.15 0.70 1</ambient>
            <diffuse>0.08 0.20 0.85 1</diffuse>
            <specular>0.10 0.20 0.50 1</specular>
          </material>
        </visual>

        <collision name="collision_valve_handle">
          <geometry>
            <box>
              <size>0.06 0.015 0.024</size>
            </box>
          </geometry>
        </collision>
      </link>

      <joint name="joint_valve_to_handle" type="revolute">
        <parent>valve_body</parent>
        <child>valve_handle</child>
        <axis>
          <xyz>0 0 1</xyz> 
          <limit>
            <lower>0</lower>
            <upper>1.5708</upper> 
            <effort>5.0</effort> 
            <velocity>2.0</velocity> 
          </limit>
          <dynamics>
            <damping>0.2</damping>
            <friction>0.5</friction> 
          </dynamics>
        </axis>
      </joint>

      <link name="connection_nozzle">
        <pose>0.340 0 0.30 0 1.5708 0</pose>

        <visual name="visual_nozzle">
          <geometry>
            <cylinder>
              <radius>0.015</radius>   
              <length>0.060</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>

        <collision name="collision_nozzle">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.060</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <joint name="joint_valve_to_nozzle" type="fixed">
        <parent>valve_body</parent>
        <child>connection_nozzle</child>
      </joint>

    </model>

    <include>
      <uri>model://fuel_trail</uri>
      <pose>0 0 0.0 0 0 0</pose>
    </include>

    <model name="damaged_pipe">
      <static>true</static>
      <pose>26 -6.44 0.865 1.570759 0 0.294</pose>
      <link name="pipe_link">
        <self_collide>false</self_collide>
        <gravity>true</gravity>
        <inertial>
          <mass>0.20</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="pipe_visual">
          <geometry>
            <mesh>
              <uri>../models/gale_crater_patch2/meshes/damaged_pipe.obj</uri>
              <scale>1.35 1.35 1.35</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.68 0.68 0.72 1</ambient>
            <diffuse>0.82 0.82 0.86 1</diffuse>
            <specular>0.95 0.95 0.98 1</specular>
          </material>
        </visual>
        <collision name="pipe_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 0.12 0.12</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
