<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="arc_recorder">
    <!--
      Anatolian Rover Challenge (ARC'26) - Collaboration Mission data
      recorder. Reconstructed from the dimensioned technical drawing in
      Section 8.6 "Recorder - Collaboration Mission" (ARC'26 Manual v.3,
      page 48).

      Reference dimensions taken from the drawing (mm -> m):
        - Total height (to top of handle ridge) ................. 335 mm -> 0.335 m
        - Height to top of main body (handle mound start) ....... 295 mm -> 0.295 m
        - Footprint width (front-to-back in side view) ........... 300 mm -> 0.300 m
        - Handle grip aperture width .............................. 90 mm -> 0.090 m
        - Handle region height callout ............................. 34 mm -> 0.034 m
        - Connector offset from top reference line ................. 26 mm -> 0.026 m

      Coordinate convention: model origin (0,0,0) is at the centre of
      the flat bottom face of the canister. +X points toward the
      connector/cable side (the "right" side in the manual's side-view
      drawing); -X points toward the chamfered corner (the "left" side
      in the drawing). +Z is up.

      Per Manual section 7.1.4.1 step 2 ("Transport the Recorder"), the
      recorder starts connected to cables at the Sensor Zone; the rover
      disconnects it and carries it to the base by its handle. The
      recorder is therefore modeled as a free (non-static) rigid body
      so it can be picked up and relocated in simulation.
    -->

    <static>false</static>

    <link name="recorder_link">

      <inertial>
        <mass>0.9</mass>
        <pose>0 0 0.16 0 0 0</pose>
        <inertia>
          <ixx>0.0090</ixx>
          <iyy>0.0095</iyy>
          <izz>0.0060</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- ============================================================ -->
      <!-- VISUAL: jerry-can shaped body with chamfered top-left corner, -->
      <!-- low integrated carry handle, connector boss + plug, and the   -->
      <!-- coiled cable running off toward the paired sensor unit.       -->
      <!-- ============================================================ -->

      <visual name="visual_body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/recorder_body.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.35 0.20 0.05 1</ambient>
          <diffuse>0.72 0.45 0.13 1</diffuse>
          <specular>0.4 0.3 0.15 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- Carry handle: oval grip loop molded into the top of the can,
           mounted on the flat deck at the top of the body mesh
           (z = 0.313 m, the "shoulder_top" height). -->
      <visual name="visual_handle">
        <pose>0 0 0.313 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/recorder_handle.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.30 0.17 0.04 1</ambient>
          <diffuse>0.65 0.40 0.11 1</diffuse>
          <specular>0.4 0.3 0.15 1</specular>
        </material>
      </visual>

      <!-- Connector socket housing on the right shoulder -->
      <visual name="visual_connector_socket">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/connector_socket.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.09 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Connector plug inserted into the socket -->
      <visual name="visual_connector_plug">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/connector_plug.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.11 1</ambient>
          <diffuse>0.30 0.30 0.32 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Coiled cable running from the connector toward the paired
           ground sensor unit (see arc_sensor model). -->
      <visual name="visual_cable">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/cable.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- ============================================================ -->
      <!-- COLLISION: simplified compound primitives approximating the   -->
      <!-- visual envelope (rounded box body + a small box for the       -->
      <!-- handle loop, for efficient physics-engine collision           -->
      <!-- checking and so the rover's gripper has a clean shape to      -->
      <!-- grasp by the handle).                                         -->
      <!-- ============================================================ -->

      <!-- Main body, approximated as a box: 300mm x 220mm x ~295mm -->
      <collision name="collision_body">
        <pose>0 0 0.1475 0 0 0</pose>
        <geometry>
          <box>
            <size>0.300 0.220 0.295</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Handle mound / low shoulder cap region -->
      <collision name="collision_shoulder">
        <pose>0 0 0.304 0 0 0</pose>
        <geometry>
          <box>
            <size>0.220 0.160 0.018</size>
          </box>
        </geometry>
      </collision>

      <!-- Handle grip bar (the part a gripper/rover arm would grasp),
           spanning the aperture at the top of the unit. -->
      <collision name="collision_handle">
        <pose>0 0 0.324 0 0 0</pose>
        <geometry>
          <box>
            <size>0.090 0.022 0.022</size>
          </box>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>
