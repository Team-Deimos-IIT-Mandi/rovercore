<?xml version="1.0" ?>

<sdf version="1.8">

  <world name="empty">

    

    <physics name="1ms" type="ignored">

      <max_step_size>0.001</max_step_size>

      <real_time_factor>1.0</real_time_factor>

    </physics>



    <plugin

      filename="gz-sim-physics-system"

      name="gz::sim::systems::Physics">

    </plugin>

    <plugin

      filename="gz-sim-user-commands-system"

      name="gz::sim::systems::UserCommands">

    </plugin>

    <plugin

      filename="gz-sim-scene-broadcaster-system"

      name="gz::sim::systems::SceneBroadcaster">

    </plugin>



    <light type="directional" name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>

      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>

        <range>1000</range>

        <constant>0.9</constant>

        <linear>0.01</linear>

        <quadratic>0.001</quadratic>

      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>

    </light>



    <model name="ground_plane">

      <static>true</static>

      <link name="link">

        <collision name="collision">

          <geometry>

            <plane>

              <normal>0 0 1</normal>

              <size>100 100</size>

            </plane>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <plane>

              <normal>0 0 1</normal>

              <size>100 100</size>

            </plane>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.8 0.8 0.8 1</diffuse>

            <specular>0.8 0.8 0.8 1</specular>

          </material>

        </visual>

      </link>

    </model>



    <model name="arc_oxygen_tank">

      <static>true</static>

      <pose>1.5 0 0 0 0 -1.5708</pose>

      

      <link name="link">

        

        <collision name="support_collision">

          <pose>0 0 0.15 0 0 0</pose>

          <geometry>

            <box>

              <size>0.25 0.70 0.30</size>

            </box>

          </geometry>

        </collision>

        <visual name="support_visual">

          <pose>0 0 0.15 0 0 0</pose>

          <geometry>

            <box>

              <size>0.25 0.70 0.30</size>

            </box>

          </geometry>

          <material>

            <ambient>0.5 0.5 0.5 1</ambient>

            <diffuse>0.5 0.5 0.5 1</diffuse>

          </material>

        </visual>



        <collision name="tank_collision">

          <pose>0 0 0.45 0 1.5708 1.5708</pose>

          <geometry>

            <box>

              <size>0.24 0.60 0.24</size>

            </box>

          </geometry>

        </collision>

        <visual name="tank_visual">

          <pose>0 0 0.45 0 1.5708 1.5708</pose>

          <geometry>

            <cylinder>

              <radius>0.12</radius>

              <length>0.60</length>

            </cylinder>

          </geometry>

          <material>

            <ambient>0.05 0.35 0.05 1</ambient>

            <diffuse>0.1 0.5 0.1 1</diffuse>

          </material>

        </visual>



        <visual name="tank_dome_visual">

          <pose>0 -0.30 0.45 0 0 0</pose>

          <geometry>

            <sphere>

              <radius>0.12</radius>

            </sphere>

          </geometry>

          <material>

            <ambient>0.05 0.35 0.05 1</ambient>

            <diffuse>0.1 0.5 0.1 1</diffuse>

          </material>

        </visual>



        <visual name="valve_stem_visual">

          <pose>0 -0.40 0.45 0 1.5708 1.5708</pose>

          <geometry>

            <cylinder>

              <radius>0.02</radius>

              <length>0.10</length>

            </cylinder>

          </geometry>

          <material>

            <ambient>0.6 0.6 0.6 1</ambient>

            <diffuse>0.7 0.7 0.7 1</diffuse>

          </material>

        </visual>



        <collision name="valve_wheel_collision">

          <pose>0 -0.45 0.45 0 1.5708 1.5708</pose>

          <geometry>

            <box>

              <size>0.15 0.03 0.15</size>

            </box>

          </geometry>

        </collision>

        <visual name="valve_wheel_visual">

          <pose>0 -0.45 0.45 0 1.5708 1.5708</pose>

          <geometry>

            <cylinder>

              <radius>0.075</radius>

              <length>0.03</length>

            </cylinder>

          </geometry>

          <material>

            <ambient>1.0 0.0 0.0 1</ambient>

            <diffuse>1.0 0.0 0.0 1</diffuse>

            <specular>0.4 0.4 0.4 1</specular>

            <emissive>0.1 0.0 0.0 1</emissive>

          </material>

        </visual>



      </link>

    </model>



    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>



  </world>

</sdf>