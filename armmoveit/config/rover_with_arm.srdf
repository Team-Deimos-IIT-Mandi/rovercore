<?xml version="1.0" encoding="UTF-8"?>
<robot name="rover_with_arm">
    <group name="arm">
        <chain base_link="chassis_link" tip_link="gripper-base" />
    </group>

    <group name="gripper">
        <joint name="claw1-slide"/>
        <joint name="finger1-rotate"/>
        <joint name="claw2-slide"/>
        <joint name="finger2-rotate"/>
    </group>

    <group_state name="home" group="arm">
        <joint name="link_1" value="0.52"/>
        <joint name="link_2" value="-0.0608"/>
        <joint name="link_3" value="0.6245"/>
        <joint name="wrist_1" value="-0.7546"/>
        <joint name="z_axis" value="3.6544"/>
        <joint name="gripper-wrist" value="0.0"/> 
    </group_state>

    <end_effector name="gripper" parent_link="gripper-base" group="gripper" parent_group="arm"/>
    
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    
    <passive_joint name="LB_joint"/>
    <passive_joint name="LF_joint"/>
    <passive_joint name="RB_joint"/>
    <passive_joint name="RF_joint"/>

    <disable_collisions link1="CAM_FL" link2="CAM_FR" reason="Never"/>
    <disable_collisions link1="CAM_FL" link2="CAM_FRONT" reason="Never"/>
    <disable_collisions link1="CAM_FL" link2="CAM_LEFT" reason="Never"/>
    <disable_collisions link1="CAM_FL" link2="CAM_REAR" reason="Never"/>
